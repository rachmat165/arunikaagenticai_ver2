# REFLECTIVE KOALA — Environment Variables
# Copy this file to .env.local and fill in your values

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Supabase (RAG & Knowledge Base)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_KEY=your_service_key

# Google APIs
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Meta APIs (Instagram, Facebook)
META_GRAPH_API_TOKEN=
META_BUSINESS_ACCOUNT_ID=

# TikTok API
TIKTOK_API_KEY=
TIKTOK_ACCESS_TOKEN=

# YouTube API
YOUTUBE_API_KEY=

# Firecrawl (Web Scraping)
FIRECRAWL_API_KEY=

# OpenAI Whisper (Speech-to-Text)
OPENAI_API_KEY=

# Settings
DEBUG=false
LOG_LEVEL=INFO
DATABASE_PATH=D:\ArunikaAgenticAi_Ver2\data\state.db
CONFIG_PATH=D:\ArunikaAgenticAi_Ver2\data\config.yaml
